# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# BetterAuth
BETTER_AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/wikra_auth

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Allowed Origins (comma-separated, for CORS/trusted origins from client apps)
ALLOWED_ORIGINS=http://localhost:3000

# Trusted Clients (JSON array) - Optional: for pre-registered clients that skip consent
# Clients registered via the dashboard UI (/dashboard/clients) are stored in the DB
# and don't need to be listed here. Use this only for hardcoded trusted clients.
# Example:
# TRUSTED_CLIENTS='[{"clientId":"dapur-buwikra","clientSecret":"secret-here","name":"Dapur Bu Wikra","redirectUrls":["http://localhost:3000/api/auth/callback/wikra-auth"]}]'
TRUSTED_CLIENTS=
