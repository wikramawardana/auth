# Local Vault connection. Keep the real token only in your untracked .env.local.
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=your-local-vault-token
VAULT_SECRET_PATH=secret/auth-local

# Offline fallbacks (used only when Vault is not configured)
NEXT_PUBLIC_APP_URL=http://localhost:3200
AUTH_URL=http://localhost:3200
BETTER_AUTH_URL=http://localhost:3200
BETTER_AUTH_SECRET=your-better-auth-secret
DATABASE_URL=postgresql://user:password@localhost:5432/auth-dev
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
PORT=3200
